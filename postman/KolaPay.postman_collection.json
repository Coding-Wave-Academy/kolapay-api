    {
      "name": "4. Transfers",
      "item": [
        {
          "name": "Send 5,000",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"{{recipientId}}\",\n  \"amount\": 5000,\n  \"note\": \"Eru at Buea market\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Charged 5,000 + 50 fee\", () => pm.expect(json.transaction.total).to.eql(5050));",
                  "const before = Number(pm.variables.get(\"balance\"));",
                  "if (before) pm.test(\"Balance went down by 5,050\", () => pm.expect(json.balance).to.eql(before - 5050));",
                  "const store = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "store.set(\"balance\", json.balance);"
                ]
              }
            }
          ]
        },
        {
          "name": "Not enough money",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfers"
              ]
            },
            "description": "INSUFFICIENT_FUNDS, with how much is missing in details.needed.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"{{recipientId}}\",\n  \"amount\": 500000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));",
                  "const json = pm.response.json();",
                  "pm.test(\"Error code is INSUFFICIENT_FUNDS\", () => pm.expect(json.error.code).to.eql(\"INSUFFICIENT_FUNDS\"));",
                  "pm.test(\"Error has a message for the user\", () => pm.expect(json.error.message).to.be.a('string').and.not.empty);",
                  "pm.test(\"Says how much is missing\", () => pm.expect(json.error.details.needed).to.be.above(0));"
                ]
              }
            }
          ]
