              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfers per team",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-admin-secret",
                "value": "{{adminSecret}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "stats"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "Log in with a wrong PIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Shows the INVALID_PIN error and attemptsLeft. Three in a row lock the account for 5 minutes.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"pin\": \"0000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "const json = pm.response.json();",
                  "pm.test(\"Error code is INVALID_PIN\", () => pm.expect(json.error.code).to.eql(\"INVALID_PIN\"));",
                  "pm.test(\"Error has a message for the user\", () => pm.expect(json.error.message).to.be.a('string').and.not.empty);",
                  "pm.test(\"Says how many attempts are left\", () => pm.expect(json.error.details.attemptsLeft).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Saves `token` automatically. The PIN is sent as text: \"1234\", not 1234.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"pin\": \"{{pin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Returns a token\", () => pm.expect(json.token).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"Returns the account\", () => pm.expect(json.account.id).to.eql(pm.variables.get(\"accountId\").toUpperCase()));",
                  "const store = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "store.set(\"token\", json.token);",
                  "store.set(\"balance\", json.account.balance);"
                ]
              }
            }
          ]
        }
      ]
    },
