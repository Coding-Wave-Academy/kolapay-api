{
  "info": {
    "name": "KolaPay API",
    "description": "Practice mobile-money API for the iTek Labs JavaScript course.\n\n**Setup**\n1. Import this collection and the environment you want (Local or Render), then select the environment top right.\n2. Teams: paste your team key into the `apiKey` variable. Organiser: fill `adminSecret` and run **1. Admin → Create team key**, which saves `apiKey` for you.\n3. Run **2. Auth → Log in**. It saves `token` automatically, so every other request just works.\n\nRun the whole collection with the Runner to test everything. **9. Danger zone → Reset all data** restores the seed: never run it during class.\n\nDocs: `/docs` on the API server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/v1"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "adminSecret",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "accountId",
      "value": "KP-0042"
    },
    {
      "key": "pin",
      "value": "1234"
    },
    {
      "key": "recipientId",
      "value": "KP-0107"
    },
    {
      "key": "newContactId",
      "value": "KP-1003"
    },
    {
      "key": "contactId",
      "value": ""
    },
    {
      "key": "balance",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "No key needed. Run this first to wake the free Render server (it can take about a minute).",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Server says ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Admin (organiser only)",
      "description": "Needs `adminSecret`. Never share it with teams or put it in api.js.",
      "item": [
        {
          "name": "Create team key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-secret",
                "value": "{{adminSecret}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/teams",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "teams"
              ]
            },
            "description": "Creates a team and returns its API key ONCE. The test script saves it into `apiKey`.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Team 1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Key starts with kp_team_\", () => pm.expect(json.apiKey).to.match(/^kp_team_/));",
                  "const store = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "store.set(\"apiKey\", json.apiKey);",
                  "console.log(\"Saved apiKey for\", json.name, \"->\", json.apiKey);"
                ]
              }
            }
          ]
        },
        {
          "name": "List teams",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-admin-secret",
                "value": "{{adminSecret}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/teams",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "teams"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns a list\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "List accounts and intern PINs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-admin-secret",
                "value": "{{adminSecret}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "accounts"
              ]
            },
            "description": "Every account with its starting PIN. Use it to print the intern PIN slips.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const interns = pm.response.json().data.filter((a) => a.intern);",
                  "pm.test(\"Has intern accounts with 4-digit PINs\", () => {",
                  "  pm.expect(interns.length).to.be.above(0);",
                  "  interns.forEach((a) => pm.expect(a.startingPin).to.match(/^\\d{4}$/));",
                  "});",
                  "console.table && console.table(interns.map(({ id, name, startingPin }) => ({ id, name, startingPin })));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rename an intern",
          "request": {
            "method": "PATCH",
            "header": [
