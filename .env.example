# Copy to .env for local development.
DATABASE_URL=postgres://postgres@localhost:5432/kolapay
# Set to true only when connecting to Render's External Database URL from your laptop.
DATABASE_SSL=false
ADMIN_SECRET=change-me-to-a-long-random-string
PORT=4000
CORS_ORIGIN=*
PIN_LOCK_MINUTES=5
SESSION_HOURS=8
RATE_LIMIT_PER_MINUTE=300
INTERN_COUNT=20
